# Copy this file to .env and fill in real values. .env must stay gitignored.

# --- Web server (one app for everything, port 5003) ---
# 0.0.0.0 lets other devices open http://<pi-ip>:5003
HOST=0.0.0.0
PORT=5003
# Any long random text (keeps logins and carts working across restarts)
FLASK_SECRET_KEY=change-me-to-something-random
REPORT_TIMEZONE=America/Toronto
# Optional: another database file (default: smartstore.db in this folder)
# DATABASE_PATH=/home/pi/Smart-store/Phase 4/smartstore.db

# --- Gmail (receipts, low-stock notices, fridge alerts + YES/NO replies) ---
# Create an App Password: https://myaccount.google.com/apppasswords (2-Step Verification on)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-project-gmail@gmail.com
SMTP_APP_PASSWORD=xxxxxxxxxxxxxxxx
STORE_NAME=Smart Store

# --- Stock alerts ---
# Default "low stock" limit. Each category can get its own limit in Reports > Inventory.
LOW_STOCK_LIMIT=5

# --- CF600 RFID reader (must be in CDC mode, see Phase 3 README) ---
RFID_PORT=auto
RFID_BAUD=115200
RFID_SCAN_SECONDS=2
# 1 = no reader plugged in (laptop testing)
RFID_SIMULATE=0
RFID_SIMULATED_TAGS=E28011700000020A1B2C3D01,E28011700000020A1B2C3D02,E28011700000020A1B2C3D04
RFID_REUSE_SOLD_TAGS=0

# --- Phase 2: fridges (ESP32 + DHT11 -> Mosquitto) and fan ---
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
# Who gets the temperature alert email, and who may answer YES / NO
ALERT_RECIPIENT_EMAIL=whoever-should-get-the-alert@gmail.com
IMAP_HOST=imap.gmail.com
IMAP_POLL_SECONDS=10
# Address inside the backup Yes/No links of the email. Use the Pi's LAN IP (hostname -I), not localhost.
PUBLIC_BASE_URL=http://192.168.1.50:5003
# Minimum seconds between two alert emails for the same fridge
ALERT_COOLDOWN_SECONDS=300
# How often a DHT11 reading is saved for the history charts
FRIDGE_HISTORY_SECONDS=30
# A fridge is offline after this many seconds without a new reading (ESP32 sends every 2 s).
FRIDGE_STALE_SECONDS=30

# --- Minew MSP01 BLE sensor (temperature, humidity, light, motion) ---
# 1 = scan for the sensor over Bluetooth on the Pi (needs bleak). Leave the address empty to accept any MSP01.
MSP01_BLE=0
MINEW_DEVICE_ADDRESS=
# MQTT topic the sensor readings can be published to (JSON)
MSP01_MQTT_TOPIC=MSP01
# Secret for POSTing readings to /sensors/api/ingest from a gateway (empty = only logged-in admins)
SENSOR_INGEST_TOKEN=
# Seconds without a reading before the sensor is shown as offline
SENSOR_STALE_SECONDS=300
# 1 = fake sensor values for demos/testing without the hardware
MSP01_SIMULATE=0
