# Copy to .env. Local configuration must never be committed.
HOST=127.0.0.1
PORT=5003
REPORT_TIMEZONE=America/Toronto

# Optional absolute path to the existing Phase 3 database.
# When omitted, defaults to ../Phase 3/smartstore.db relative to this folder.
# PHASE3_DATABASE_PATH=C:/path/to/Smart-store/Phase 3/smartstore.db

# Set the real sensor address when BLE integration is implemented.
MINEW_DEVICE_ADDRESS=
