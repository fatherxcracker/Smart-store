# Copy to .env. Local configuration must never be committed.
HOST=127.0.0.1
PORT=5003
REPORT_TIMEZONE=America/Toronto

# Optional path to Phase 4's OWN database (relative to this folder or absolute).
# Defaults to database/smartstore.db. Do not use an earlier phase's database.
# PHASE4_DATABASE_PATH=database/smartstore.db

# Set these locally for receipt email; earlier phases' .env files are not loaded.
SMTP_EMAIL=
SMTP_APP_PASSWORD=
# Set a persistent random value to keep sessions after restarting.
# FLASK_SECRET_KEY=

# Set the real sensor address when BLE integration is implemented.
MINEW_DEVICE_ADDRESS=
