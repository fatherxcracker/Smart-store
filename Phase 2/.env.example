# Copy this file to .env and fill in real values. .env is gitignored -
# never commit real credentials.

# --- MQTT broker (Mosquitto running on this Raspberry Pi) ---
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# --- Email alerts (Gmail App Password) ---
# 1. Turn on 2-Step Verification on the Gmail account you want to send from.
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Paste the 16-character app password below (not your normal Gmail password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-project-gmail@gmail.com
SMTP_APP_PASSWORD=xxxxxxxxxxxxxxxx
ALERT_RECIPIENT_EMAIL=whoever-should-get-the-alert@gmail.com

# --- Reading the YES/NO reply (IMAP, same Gmail account + App Password) ---
# The Pi checks this inbox for replies to the alert email.
IMAP_HOST=imap.gmail.com
IMAP_POLL_SECONDS=10

# --- Backup Yes/No links inside the alert email (used only if you can't reply) ---
# Must be reachable from wherever you'll read the email (phone, laptop) -
# use the Raspberry Pi's LAN IP, NOT localhost. Find it with: hostname -I
PUBLIC_BASE_URL=http://192.168.1.50:5001

# --- Alert behaviour ---
# Minimum seconds between two alert emails for the same fridge.
ALERT_COOLDOWN_SECONDS=300
