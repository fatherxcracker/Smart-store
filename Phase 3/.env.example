# Copy this file to .env and fill in real values. .env must stay gitignored.

# --- Receipt emails (same Gmail App Password setup as Phase 2) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-project-gmail@gmail.com
SMTP_APP_PASSWORD=xxxxxxxxxxxxxxxx

# --- Store settings ---
STORE_NAME=Smart Store
# Products at or below this quantity trigger a low-stock warning
LOW_STOCK_LIMIT=5
