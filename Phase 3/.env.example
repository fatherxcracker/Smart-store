# Copy this file to .env and fill in real values. .env must stay gitignored.

# --- Receipt emails (same Gmail App Password setup as Phase 2) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-project-gmail@gmail.com
SMTP_APP_PASSWORD=xxxxxxxxxxxxxxxx

# --- Store settings ---
STORE_NAME=Smart Store
# Products at or below this quantity trigger a low-stock warning
LOW_STOCK_LIMIT=5

# --- Web server ---
# 0.0.0.0 lets other devices on the network open http://<pi-ip>:5002
HOST=0.0.0.0
PORT=5002
# Any long random text (keeps logins and carts working across restarts)
FLASK_SECRET_KEY=change-me-to-something-random

# --- CF600 RFID reader (see README "RFID reader setup") ---
RFID_PORT=/dev/ttyUSB0
RFID_BAUD=115200
# How long one "Scan all items" press reads for (seconds)
RFID_SCAN_SECONDS=2
# 1 = no reader plugged in (laptop testing): pretend these tags are on the reader
RFID_SIMULATE=0
RFID_SIMULATED_TAGS=E28011700000020A1B2C3D01,E28011700000020A1B2C3D02,E28011700000020A1B2C3D04
